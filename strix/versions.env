# The maintained successor (awesomized/libmemcached 1.1.x) is a CMake rewrite.
LIBMEMCACHED_VERSION=1.0.18
LIBMEMCACHED_SHA256=e22c0bb032fde08f53de9ffbc5a128233041d9f33b5de022c0978a2149885f82
