ZLIB_VERSION=1.3.1
ZLIB_SHA256=9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23
YAML_VERSION=0.2.5
YAML_SHA256=c642ae9b75fee120b2d96c712538bd2cf283228d2337df2cf2988e3c02678ef4
LIBFFI_VERSION=3.4.6
LIBFFI_SHA256=b0dea9df23c863a7a50e825440f3ebffabd65df1497108e5d437747843895a4e
# SQLite encodes 3.45.1 as 3450100 and files releases under a year directory
SQLITE_VERSION=3450100
SQLITE_YEAR=2024
SQLITE_SHA256=cd9c27841b7a5932c9897651e20b86c701dd740556989b01ca596fcfa3d49a0a
LIBXML2_VERSION=2.12.9
LIBXML2_SHA256=59912db536ab56a3996489ea0299768c7bcffe57169f0235e7f962a91f483590
LIBXSLT_VERSION=1.1.42
LIBXSLT_SHA256=85ca62cac0d41fc77d3f6033da9df6fd73d20ea2fc18b0a3609ffb4110e1baeb
# Metasploit: git tag + the commit it must resolve to (verified after clone)
MSF_REF=6.4.125
MSF_COMMIT=3f83860a9b85b4191b9eec48bb7125b8557eaf6d
# Bundler that runs the MSF bundle install (.gem sha256-verified on fetch). Keep it = the
# Bundler shipped with RUBY_VERSION (3.3.6 -> 2.5.22): the device runs the cross Ruby's own
# Bundler against the same lockfile. 2.5+ enforces the lockfile CHECKSUMS. Manual bump.
# Gem checksums: ruby-msf/02-msf/Gemfile.lock = MSF's lockfile + CHECKSUMS, regenerated by
# scripts/msf-gemlock.sh update (the msf track does it on every MSF bump).
BUNDLER_VERSION=2.5.22
BUNDLER_SHA256=763f30d598ee58742eea29285875435ea722218d4df149de35bce37c02ce968e

# ---- bundle manifests ----------------------------------------------------------
# Lowest app versionCode able to consume each bundle (written into <bundle>.json)
TOOLS_BUNDLE_MIN_APP=2
MSF_BUNDLE_MIN_APP=2
