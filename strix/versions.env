# Single source of truth for the native bundle pipelines (tools/ and ruby-msf/).
#
# Format: plain KEY=VALUE lines only (no quotes, no spaces, no $expansion).
# It is read by bash (`source`), turned into `docker buildx build --build-arg`
# by scripts/lib.sh, and parsed by .github/workflows/check-updates.yml.
#
# Every *_SHA256 is the SHA256 of the exact upstream file the Dockerfiles download, checked
# by scripts/fetch.sh at build time. On top of that, releases that upstream signs are
# verified at build time AND by the updater before a bump against the OpenPGP keys pinned in
# scripts/keys/ (one keyring + fingerprints per project, see scripts/verify-sig.sh): nmap,
# libpcap, tcpdump, libidn, openssl, curl, libssh2, libssh, pcre2, libgpg-error, libgcrypt,
# zlib, mariadb, cyrus-sasl. Unsigned upstreams, cross-checked once against published digests: NDK
# (sha1, Google repository XML), postgresql (.sha256), ruby (release notes), lua (download
# page), sqlite (sha3-256), libxml2/libxslt (.sha256sum), libnet (.sha256 asset), libmemcached
# (launchpad md5). Trust-on-first-use: hydra, ettercap (tag snapshots), geoip, libyaml,
# libffi. Git pins (RTMPDUMP_COMMIT, MSF_COMMIT) are verified after fetch. MSF gems: sha256
# per gem in ruby-msf/02-msf/Gemfile.lock (scripts/msf-gemlock.sh). Changing a *_VERSION
# without updating its *_SHA256 makes the build fail - by design.

# ---- shared ---------------------------------------------------------------
BASE_IMAGE=ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
NDK_VERSION=r27c
NDK_SHA256=59c2f6dc96743b5daf5d1626684640b20a6bd2b1d85b13156b90333741bad5cc
API_LEVEL=29
OPENSSL_VERSION=3.2.1
OPENSSL_SHA256=83c7329fe52c850677d75e5d0b0ca245309b97e8ecbcfdc1dfdc4ab9fac35b39
LIBPCAP_VERSION=1.10.5
LIBPCAP_SHA256=37ced90a19a302a7f32e458224a00c365c117905c2cd35ac544b6880a81488f0
POSTGRESQL_VERSION=16.2
POSTGRESQL_SHA256=446e88294dbc2c9085ab4b7061a646fa604b4bec03521d5ea671c2e5ad9b2952

